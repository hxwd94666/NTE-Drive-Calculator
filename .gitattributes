* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.iss text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.msi binary

# Component manifests verify exact bytes, including line endings of notices.
/third_party/analysis-core/** -text
/third_party/native-capture/** -text
/third_party/mod-loader/** -text
/third_party/mods-plugin/** -text
/third_party/nte-core/** -text


# Upstream hashed text is byte-exact, not authored source whitespace.
/third_party/analysis-core/THIRD_PARTY_NOTICES.txt -whitespace
/third_party/native-capture/compatibility.json -whitespace
/third_party/native-capture/component-bundle.json -whitespace
/third_party/native-capture/core/SOURCE.md -whitespace
