* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.iss text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.msi binary

# Component manifests verify exact bytes, including line endings of notices.
/third_party/analysis-core/** -text
/third_party/native-capture/** -text
/third_party/mod-loader/** -text
/third_party/mods-plugin/** -text
/third_party/nte-core/** -text

