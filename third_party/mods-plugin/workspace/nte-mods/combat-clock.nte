#include <nte/mod.hpp>

NTE_SCRIPT(5);
NTE_MOD("combat-clock");
NTE_BIND("feature.dps-time-stop");
NTE_REQUIRES("viewport.tick");
NTE_REQUIRES("game.session");
NTE_REQUIRES("combat-clock");
NTE_REQUIRES("ipc");
NTE_ROUTE_IPC(11, "combat_clock.query_transitions");
NTE_ROUTE_IPC(12, "ipc.query_mod_events");

std::uint64_t initialized = 0;
std::uint64_t last_controller = 0;
std::uint64_t last_pause_mask = 0;
std::uint64_t last_state_flags = 0;

void on_viewport_tick(const nte::viewport_tick_event& event)
{
    const auto player_controller = nte::game::player_controller;
    std::uint64_t pause_mask = 0;
    std::uint64_t state_flags = 0;
    if (player_controller != nullptr)
    {
        pause_mask = nte::combat_clock::pause_mask(player_controller);
        state_flags = nte::combat_clock::state_flags(player_controller);
        nte::ipc::bind(nullptr, player_controller);
    }
    auto changed = initialized == false;
    if (player_controller != last_controller)
    {
        changed = true;
    }
    if (pause_mask != last_pause_mask)
    {
        changed = true;
    }
    if (state_flags != last_state_flags)
    {
        changed = true;
    }
    if (changed == true)
    {
        nte::combat_clock::forward(pause_mask, state_flags);
        initialized = 1;
        last_controller = player_controller;
        last_pause_mask = pause_mask;
        last_state_flags = state_flags;
    }
}
