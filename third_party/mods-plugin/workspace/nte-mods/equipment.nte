#include <nte/mod.hpp>

NTE_SCRIPT(5);
NTE_MOD("equipment");
NTE_BIND("feature.empty-curtain-equipment");
NTE_REQUIRES("viewport.tick");
NTE_REQUIRES("game.session");
NTE_REQUIRES("equipment");
NTE_REQUIRES("ipc");
NTE_ROUTE_IPC(1, "equipment.equip_module");
NTE_ROUTE_IPC(2, "equipment.equip_core");
NTE_ROUTE_IPC(3, "equipment.unequip_module");
NTE_ROUTE_IPC(4, "equipment.unequip_core");
NTE_ROUTE_IPC(5, "equipment.unequip_all");
NTE_ROUTE_IPC(6, "equipment.equip_one_key");
NTE_ROUTE_IPC(7, "equipment.move_module_to_character");
NTE_ROUTE_IPC(8, "equipment.move_core_to_character");
NTE_ROUTE_IPC(9, "equipment.set_item_discarded");
NTE_ROUTE_IPC(10, "equipment.set_item_locked");
NTE_ROUTE_IPC(12, "ipc.query_mod_events");

std::uint64_t last_player_state = 0;
std::uint64_t next_prepare_at = 0;

void on_viewport_tick(const nte::viewport_tick_event& event)
{
    const auto player_state = nte::game::player_state;
    const auto now = nte::time::now_ms();
    if (player_state != nullptr)
    {
        if (player_state != last_player_state)
        {
            last_player_state = player_state;
            next_prepare_at = 0;
        }
        auto cache_ready = nte::equipment::cache_ready(player_state);
        if (cache_ready == false)
        {
            if (now >= next_prepare_at)
            {
                nte::equipment::prepare(player_state);
                next_prepare_at = now + 1000;
                cache_ready = nte::equipment::cache_ready(player_state);
            }
        }
        if (cache_ready == true)
        {
            nte::ipc::bind(player_state, nullptr);
        }
    }
}
